{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm run *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm build)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm -r build)",
      "Bash(pnpm -r typecheck)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm ls *)",
      "Bash(pnpm why *)",
      "Bash(pnpm --version)",
      "Bash(node --version)",
      "Bash(node packages/cli/dist/index.js *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git blame *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git stash list)",
      "PowerShell(pnpm install)",
      "PowerShell(pnpm run *)",
      "PowerShell(pnpm test)",
      "PowerShell(pnpm test *)",
      "PowerShell(pnpm build)",
      "PowerShell(pnpm typecheck)",
      "PowerShell(pnpm lint)",
      "PowerShell(pnpm -r build)",
      "PowerShell(pnpm -r typecheck)",
      "PowerShell(pnpm exec vitest *)",
      "PowerShell(pnpm exec tsc *)",
      "PowerShell(pnpm exec eslint *)",
      "PowerShell(pnpm ls *)",
      "PowerShell(pnpm why *)",
      "PowerShell(pnpm --version)",
      "PowerShell(node --version)",
      "PowerShell(node packages/cli/dist/index.js *)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git log)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch)",
      "PowerShell(git branch --list *)",
      "PowerShell(git blame *)",
      "PowerShell(git remote -v)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git ls-files)",
      "PowerShell(git ls-files *)",
      "PowerShell(git stash list)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm publish *)",
      "Bash(git push *)",
      "PowerShell(pnpm add *)",
      "PowerShell(pnpm remove *)",
      "PowerShell(pnpm update *)",
      "PowerShell(pnpm dlx *)",
      "PowerShell(pnpm publish *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Bash(curl)",
      "Bash(curl *)",
      "Bash(curl.exe *)",
      "Bash(wget)",
      "Bash(wget *)",
      "Bash(wget.exe *)",
      "Bash(Invoke-WebRequest *)",
      "Bash(Invoke-RestMethod *)",
      "Bash(iwr *)",
      "Bash(irm *)",
      "Bash(Start-BitsTransfer *)",
      "PowerShell(curl)",
      "PowerShell(curl *)",
      "PowerShell(curl.exe *)",
      "PowerShell(wget)",
      "PowerShell(wget *)",
      "PowerShell(wget.exe *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(iwr *)",
      "PowerShell(irm *)",
      "PowerShell(Start-BitsTransfer *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)"
    ]
  }
}